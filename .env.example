# Copiar este archivo como .env y reemplazar los valores.
MYSQL_ROOT_PASSWORD=cambiar_por_una_clave_larga
DB_PASSWORD=cambiar_por_otra_clave_larga
# Generar con PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
JWT_SECRET=reemplazar_por_32_bytes_en_base64
# Puerto local de MySQL
DB_PORT=3307
DB_USER=gamer_app
# Frontend -> backend
BACKEND_URL=http://localhost:8091
